<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon for FanControlHelper, registered with SMAppService.daemon(plistName:).
  Ship at DynamicNotch.app/Contents/Library/LaunchDaemons/com.example.dynamicnotch.DynamicNotch.fancontrol.plist
  (Xcode "Copy Files" build phase, destination: Wrapper, subpath: Contents/Library/LaunchDaemons).
  BundleProgram is relative to the app bundle root.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.dynamicnotch.DynamicNotch.fancontrol</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/FanControlHelper</string>
	<key>MachServices</key>
	<dict>
		<key>com.example.dynamicnotch.DynamicNotch.fancontrol</key>
		<true/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.example.dynamicnotch.DynamicNotch</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Adaptive</string>
</dict>
</plist>
