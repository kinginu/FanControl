<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  README: Info.plist template for the bare FanControlHelper executable. It is embedded into the
  Mach-O (there is no bundle) via the helper target's linker flags:
      OTHER_LDFLAGS = -sectcreate __TEXT __info_plist "$(SRCROOT)/FanControl/Support/Helper-Info.plist"
  (or set INFOPLIST_FILE + CREATE_INFOPLIST_SECTION_IN_BINARY = YES). Bundle.main.infoDictionary
  then returns these values at runtime.
  Replace FanControlClientTeamID with DynamicNotch's real Team ID before shipping (design doc §5.1).
-->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.example.dynamicnotch.DynamicNotch.fanfi</string>
	<key>CFBundleName</key>
	<string>FanControlHelper</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>FanControlClientTeamID</key>
	<string>TEAMID0000</string>
</dict>
</plist>
