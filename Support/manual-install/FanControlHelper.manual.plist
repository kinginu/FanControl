<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the MANUAL-INSTALL (personal use) LaunchDaemon of FanControlHelper.
  Do not install this file directly: install.sh reads the identifiers from the helper's embedded
  Info.plist (FanControlMachServiceName = <label>, ../identifiers.sh) and installs a copy at
  /Library/LaunchDaemons/<label>.plist (root:wheel 0644) with
    Label, MachServices                                  <label>
    Program                                              /Library/PrivilegedHelperTools/<label>
    EnvironmentVariables.FANCONTROL_CLIENT_REQUIREMENT   identifier "<FanControlClientBundleIdentifier>" and cdhash H"<app cdhash>"
  The values below are the DynamicNotch defaults. The helper refuses to start if
  FANCONTROL_CLIENT_REQUIREMENT is present but does not pin a cdhash
  (FanControlHelperConstants.validateManualClientRequirement). The SMAppService path uses
  ../LaunchDaemons/<label>.plist instead (BundleProgram, no env var; ../embed-helper-config.sh).
  See docs/helper.md §6 and "Configuring identifiers".
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.example.dynamicnotch.DynamicNotch.fanfi</string>
	<key>Program</key>
	<string>/Library/PrivilegedHelperTools/com.example.dynamicnotch.DynamicNotch.fanfi</string>
	<key>MachServices</key>
	<dict>
		<key>com.example.dynamicnotch.DynamicNotch.fanfi</key>
		<true/>
	</dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>FANCONTROL_CLIENT_REQUIREMENT</key>
		<string>__FILLED_IN_BY_INSTALL_SH__</string>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Adaptive</string>
</dict>
</plist>
